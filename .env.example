# pHantasma Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================================
# BASE SETTINGS
# ============================================================
DEBUG_MODE=false
ALERT_EMAIL=mail@linuxkafe.com

# Quiet hours (night mode) - 24h format
QUIET_START=23
QUIET_END=9

# ============================================================
# AUDIO HARDWARE
# ============================================================
# Input device (index or name like "hw:1,0")
ALSA_DEVICE_IN=0

# --- Required on the Jabra (prod) host. Do NOT delete these two. -------------
# config.py falls open to block_size=1600 / auto_detect=True when they are
# absent, which silently changes the ALSA framing the wake word depends on.
# deploy.sh --verify-env fails loudly instead of degrading. Keep in sync with
# the prod .env; these are the two that the refactor moved out of config.py.
AUDIO_BLOCK_SIZE=512
AUDIO_DEVICE_AUTO_DETECT=false

# The name is AUDIO_DEVICE_AUTO_DETECT. A bare AUDIO_AUTO_DETECT is NOT read by
# config.py and fails open to true. That exact typo existed in prod's .env and
# was ignored for an unknown period.
# Output device (ALSA name)
ALSA_DEVICE_OUT=plughw:0,0
# Volume 0-100
ALSA_VOLUME_PERCENT=85
# Sample rate for microphone (Whisper needs 16kHz)
MIC_SAMPLERATE=16000

# ============================================================
# VAD (Voice Activity Detection)
# ============================================================
# Aggressiveness 0-3 (higher = more aggressive filtering)
VAD_AGGRESSIVENESS=2
# Frame duration in ms (10, 20, or 30)
VAD_FRAME_DURATION_MS=30

# ============================================================
# HOTWORD DETECTION (openWakeWord)
# ============================================================
# Comma-separated model paths (container path; host dir ./models is mounted at /app/models)
WAKEWORD_MODELS=/app/models/hey_fantasma.onnx,/app/models/ola_fantasma.onnx
# Confidence threshold 0.0-1.0
WAKEWORD_CONFIDENCE=0.70
# Number of consecutive detections required
WAKEWORD_PERSISTENCE=3
# Cooldown between detections (seconds)
WAKEWORD_COOLDOWN_SECONDS=2.0

# ============================================================
# PIPELINE SETTINGS
# ============================================================
QUEUE_MAXSIZE=10
STT_MAX_AUDIO_SECONDS=30

# ============================================================
# STT (Whisper)
# ============================================================
WHISPER_MODEL=medium

# ============================================================
# LLM (Ollama)
# ============================================================
OLLAMA_HOST_PRIMARY=http://10.0.0.128:11434
OLLAMA_HOST_FALLBACK=http://localhost:11434
OLLAMA_MODEL_PRIMARY=llama3.1:8b
OLLAMA_MODEL_FALLBACK=qwen3:8b
OLLAMA_TIMEOUT=600
OLLAMA_CONTEXT_SIZE=4096
OLLAMA_THREADS=4

# Optional: override system prompt (defaults to Phantasma persona)
# SYSTEM_PROMPT=your custom prompt here

# ============================================================
# TTS (Piper)
# ============================================================
TTS_MODEL_PATH=models/tts/pt_PT-dii-high.onnx
USE_SOX_EFFECTS=true

# ============================================================
# AUDIO FEEDBACK (music + greeting on hotword)
# ============================================================
AUDIO_FEEDBACK_ENABLED=true
MUSIC_DIR=audio/music
GREETING_PATH=audio/greeting.wav

# ============================================================
# FEEDBACK DETECTION (post-response keywords)
# ============================================================
FEEDBACK_WINDOW_SECONDS=5

# ============================================================
# EXTERNAL SERVICES - SECRETS (NEVER hardcode these!)
# ============================================================

# Google Gemini API (for skills that need it)
GEMINI_API_KEY=

# Shelly Gas sensor
SHELLY_GAS_URL=

# Xiaomi Miio devices (JSON: {"Device Name": {"ip": "x.x.x.x", "token": "xxx"}})
MIIO_DEVICES_JSON={}

# Tuya devices (JSON: {"Device Name": {"ip": "x.x.x.x", "id": "xxx", "key": "xxx"}})
TUYA_DEVICES_JSON={}

# Zigbee local via Zigbee2MQTT (scripts/setup_zigbee.sh brings the stack up)
#
# ZIGBEE_DEVICES_JSON maps what you call a device to what Zigbee2MQTT publishes
# it as. `friendly_name` must match EXACTLY what Z2M uses in its topic -- if it
# does not, every command is published to a topic nobody listens to and the
# skill reports "não consegui falar com o Zigbee2MQTT" for a device that is
# perfectly reachable.
#
# For both devices here that name is the IEEE address: neither could be renamed
# in the Z2M frontend, so Z2M kept the address as the friendly name.
#
#   "forno":   on/off, the Plug PLG300 HA
#   "consumo": read-only clamp -- measures, and is asked nothing
#
# "kind": "clamp" matters: a clamp has no relay, and "desliga o consumo" is
# refused with a sentence saying why instead of publishing a command no device
# would accept.
ZIGBEE_DEVICES_JSON={"forno": {"friendly_name": "0x00124b00023771d1", "kind": "plug"},
                     "consumo": {"friendly_name": "0x00124b000204eb88", "kind": "clamp"}}
# Where the Zigbee2MQTT frontend lives. Loopback only -- it can switch the oven.
ZIGBEE2MQTT_URL=http://127.0.0.1:8090
# Topic Zigbee2MQTT publishes on. Matches its own `mqtt.base_topic`.
ZIGBEE2MQTT_BASE_TOPIC=zigbee2mqtt
# The Mosquitto broker that Zigbee2MQTT requires. It refuses to start without
# one, so this is not optional and not the same as the Z2M URL.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# Ewelink
EWELINK_USERNAME=
EWELINK_PASSWORD=
EWELINK_REGION=eu
EWELINK_DEVICES_JSON={}

# Chacon
CHACON_CLOUD_USER=
CHACON_CLOUD_PASS=

# Tapo
TAPO_USER=
TAPO_PASS=
TAPO_CAMERAS_JSON={}

# Vision model (Ollama)
OLLAMA_VISION_MODEL=llava:7b

# Weather / Air Quality
IQAIR_KEY=
HOME_COORDS=41.1737008,-8.5909798

# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_ADMIN_USERS=485604987812970496
DISCORD_STANDARD_USERS=809891715149463663,1101143698160504853
DISCORD_DAILY_LLM_LIMIT=3

# ============================================================
# PATHS
# ============================================================
SKILLS_DIR=skills
MEMORY_DB_PATH=data/memory.db
BRAIN_DB_PATH=data/flybrain.db